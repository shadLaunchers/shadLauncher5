<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Explicit application manifest.

  Required because lld-link (clang-cl builds) generates a trustInfo block with
  namespace-prefixed attributes (ms_asmv1:level instead of level), which the
  Windows SxS loader rejects with:
      "The required attribute level is missing from element requestedExecutionLevel"
  See https://github.com/llvm/llvm-project/issues/120394

  The linker-generated manifest is suppressed via /MANIFEST:NO in CMakeLists.txt;
  this file is embedded as RT_MANIFEST through src/shadLauncher5.rc instead.

  Note: no dpiAware/dpiAwareness entries here on purpose - Qt 6 sets process DPI
  awareness itself at startup, and a manifest entry would override it.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

</assembly>
